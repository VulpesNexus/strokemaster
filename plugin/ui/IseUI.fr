resource IseUIPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
    __FILE__, __LINE__,
    kIseUIPanelWidgetID,
    kPMRsrcID_None,
    kBindNone,
    Frame(0, 0, 270, 520),
    kTrue, kTrue,
    kFalse,
    kInterfacePaletteFill,
    kFalse,
    kIseUIPanelTitleKey,
    {
        IseUICheckBoxWidget(kIseUIEnabledWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 8, 262, 26) kTrue, kTrue, kAlignLeft, kIseUIEnabledKey),
        SeparatorWidget(kIseUIMasterSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 32, 262, 33) kTrue, kTrue),

        // The sections by what each switch corrects (the owner, 2026-10-31), what StrokeMaster
        // draws first, as the Illustrator panel's Stacking, Corners, and Contours follow it.
        StaticTextWidget(kIseUIShapesHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 42, 262, 58) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUIShapesHeadKey, 0),
        IseUICheckBoxWidget(kIseUIShapesWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 60, 262, 78) kTrue, kTrue, kAlignLeft, kIseUIShapesKey),
        IseUICheckBoxWidget(kIseUIInsideWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 80, 262, 98) kTrue, kTrue, kAlignLeft, kIseUIInsideKey),
        IseUICheckBoxWidget(kIseUIOpenPathsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 100, 262, 118) kTrue, kTrue, kAlignLeft, kIseUIOpenPathsKey),
        IseUICheckBoxWidget(kIseUITransparencyWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 120, 262, 138) kTrue, kTrue, kAlignLeft, kIseUITransparencyKey),

        SeparatorWidget(kIseUIShapesSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 146, 262, 147) kTrue, kTrue),
        StaticTextWidget(kIseUITextHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 154, 262, 170) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUITextHeadKey, 0),
        IseUICheckBoxWidget(kIseUITextBehindWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 172, 262, 190) kTrue, kTrue, kAlignLeft, kIseUITextBehindKey),
        IseUICheckBoxWidget(kIseUITextStoryWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 192, 262, 210) kTrue, kTrue, kAlignLeft, kIseUITextStoryKey),
        IseUICheckBoxWidget(kIseUITextStoriesWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(48, 212, 262, 230) kTrue, kTrue, kAlignLeft, kIseUITextStoriesKey),

        SeparatorWidget(kIseUICornersSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 238, 262, 239) kTrue, kTrue),
        StaticTextWidget(kIseUICornersHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 246, 262, 262) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUICornersHeadKey, 0),
        IseUICheckBoxWidget(kIseUITextMiterWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 264, 262, 282) kTrue, kTrue, kAlignLeft, kIseUITextMiterKey),
        IseUICheckBoxWidget(kIseUIShapeMiterWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 284, 262, 302) kTrue, kTrue, kAlignLeft, kIseUIShapeMiterKey),
        IseUICheckBoxWidget(kIseUIGlyphTipsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 304, 262, 322) kTrue, kTrue, kAlignLeft, kIseUIGlyphTipsKey),
        IseUICheckBoxWidget(kIseUIWholePointsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 324, 262, 342) kTrue, kTrue, kAlignLeft, kIseUIWholePointsKey),
        IseUICheckBoxWidget(kIseUIPatternPointsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 344, 262, 362) kTrue, kTrue, kAlignLeft, kIseUIPatternPointsKey),
        IseUICheckBoxWidget(kIseUIEffectCornersWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 364, 262, 382) kTrue, kTrue, kAlignLeft, kIseUIEffectCornersKey),

        SeparatorWidget(kIseUIContoursSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 390, 262, 391) kTrue, kTrue),
        StaticTextWidget(kIseUIContoursHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 398, 262, 414) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUIContoursHeadKey, 0),
        IseUICheckBoxWidget(kIseUIOverlapsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 416, 262, 434) kTrue, kTrue, kAlignLeft, kIseUIOverlapsKey),
        IseUICheckBoxWidget(kIseUIWordOutlineWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 436, 262, 454) kTrue, kTrue, kAlignLeft, kIseUIWordOutlineKey),
