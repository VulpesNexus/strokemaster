        SeparatorWidget(kIseUIFooterSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindBottom, Frame(8, 482, 262, 483) kTrue, kTrue),
        IseUIButtonWidget(kIseUIRestoreWidgetID, kSysButtonPMRsrcId, kBindLeft | kBindBottom, Frame(8, 490, 128, 512) kTrue, kTrue, kIseUIRestoreKey),
        StaticTextWidget(kIseUINoteWidgetID, kSysStaticTextPMRsrcId, kBindRight | kBindBottom, Frame(136, 493, 266, 509) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, "", 0),
    }
    kIseUIInternalMenuNameKey
};

