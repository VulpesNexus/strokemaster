resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
    /** The panel: keeps its checkboxes and the switches' file in step. */
    Class
    {
        kIseUIPanelWidgetBoss,
        kPalettePanelWidgetBoss,
        {
            IID_IPANELMENUDATA, kCPanelMenuDataImpl,
            IID_IOBSERVER, kIseUIPanelObserverImpl,
            IID_ICONTROLVIEW, kIseUIPanelViewImpl,
        }
    },
    /** The panel menu's Restore Defaults. */
    Class
    {
        kIseUIActionComponentBoss,
        kBaseActionComponentBoss,
        {
            IID_IACTIONCOMPONENT, kIseUIActionComponentImpl,
        }
    },
    /** A checkbox, and a button, that say what they do when hovered (IseUITip). */
    Class
    {
        kIseUICheckBoxWidgetBoss,
        kCheckBoxWidgetBoss,
        {
            IID_ITIP, kIseUITipImpl,
        }
    },
    Class
    {
        kIseUIButtonWidgetBoss,
        kButtonWidgetBoss,
        {
            IID_ITIP, kIseUITipImpl,
        }
    },
}}};

// The panel's icon, from the owner's artwork (tools/make_panel_icons.py): dark art for the
// light interfaces (PNGA, SVGA) and light art for the dark ones (PNGD, SVGD), which InDesign
// switches between with its interface brightness, each at 1x and 2x (kHIDPIIconOffset).
resource PNGA(kIseUIPanelIconRsrcID) "icons/StrokeMaster_N_23.png"
resource PNGA(kIseUIPanelIconRsrcID + kHIDPIIconOffset) "icons/StrokeMaster_N_46.png"
resource PNGAD(kIseUIPanelIconRsrcID) "icons/StrokeMaster_D_23.png"
resource PNGAD(kIseUIPanelIconRsrcID + kHIDPIIconOffset) "icons/StrokeMaster_D_46.png"
resource SVGA(kIseUIPanelIconRsrcID) "icons/StrokeMaster_N.svg"
resource SVGAD(kIseUIPanelIconRsrcID) "icons/StrokeMaster_D.svg"

