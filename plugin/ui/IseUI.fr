resource StringTable (kSDKDefStringsResourceID + index_enUS)
{
    k_enUS,
    kEuropeanMacToWinEncodingConverter,
    {
        kIseUICompanyKey,        kIseUICompanyValue,
        kIseUIPanelTitleKey,     "StrokeMaster",
        kIseUIRestoreMenuKey,    "Restore Defaults",
        kIseUIEnabledKey,        "StrokeMaster switch",
        kIseUITextHeadKey,       "Live text",
        kIseUITextBehindKey,     "Strokes behind other letters' fills",
        kIseUITextStoryKey,      "Across a story's threaded frames",
        kIseUITextStoriesKey,    "Across separate stories (experimental)",
        kIseUITextMiterKey,      "No miter spikes",
        kIseUIShapesHeadKey,     "Shapes, frames, and outlined text",
        kIseUIShapesKey,         "Draw their strokes",
        kIseUIWholePointsKey,    "Whole points past the miter limit",
        kIseUIPatternPointsKey,  "Also on dashed and striped strokes",
        kIseUIGlyphTipsKey,      "Trim glyph tips",
        kIseUIEffectCornersKey,  "Trim corner-effect corners",
        kIseUIWordOutlineKey,    "One outline per word (dashes, stripes)",
        kIseUIOverlapsKey,       "Overlapping contours: one outline",
        kIseUIInsideKey,         "Inside strokes",
        kIseUIOpenPathsKey,      "Open paths",
        kIseUITransparencyKey,   "Objects with opacity or effects",
        kIseUIRestoreKey,        "Restore Defaults",
        kIseUINoteKey,           "Applies to every document.",
        kIseUIEngineMissingKey,  "Engine not installed.",
        kIseUIAboutMenuKey,      "About StrokeMaster...",

        kIseUIEnabledTipKey,         "When on, StrokeMaster corrects strokes as the switches below say, on screen and in every export of every document; when off, InDesign draws every stroke itself, as without the plugin.",
        kIseUITextBehindTipKey,      "When on, text strokes are drawn beneath the fills of the other letters in their frame, so an Outside stroke no longer covers the line above or the letters before it; when off, InDesign's order.",
        kIseUITextStoryTipKey,       "When on, strokes also stay beneath the fills across the columns and threaded frames of one story; when off, within each frame only.",
        kIseUITextStoriesTipKey,     "When on, strokes also go beneath the fills of other stories they overlap, which also removes a halo drawn on purpose over another frame; when off, separate stories keep InDesign's stacking.",
        kIseUITextMiterTipKey,       "When on, the miter tips of mitered text strokes that would poke through thin parts of a letter are removed, and the others kept; when off, InDesign's miters.",
        kIseUIShapesTipKey,          "When on, StrokeMaster draws the strokes of shapes, frames, and outlined text, with the corrections below; when off, InDesign draws them, with its spilled fills and spikes.",
        kIseUIWholePointsTipKey,     "When on, a shape's own sharp point between two straight edges keeps its whole point past the miter limit; when off, it is cut flat as InDesign bevels it. Other corners past the limit stay beveled.",
        kIseUIPatternPointsTipKey,   "When on, dashed, dotted, and striped strokes also get a solid whole point at such corners; when off, the pattern's own bevel.",
        kIseUIGlyphTipsTipKey,       "When on, the sharp tips of letters are cut flush with the stroke's edge instead of ending in a long miter; when off, whole miters within the limit.",
        kIseUIEffectCornersTipKey,   "When on, the small corners a corner effect adds are beveled past the miter limit and trimmed within it, so they grow no long points; when off, they are treated as the outline's own corners.",
        kIseUIWordOutlineTipKey,     "When on, Outside dashes, dots, waves, and stripes run along one outline around letters that touch, with dashes fitted between real corners; when off, InDesign's pattern on each contour, crossing where letters meet.",
        kIseUIOverlapsTipKey,        "When on, Outside and Inside strokes go around the filled shape only, not along contour edges inside the letters (as Create Outlines leaves decorative fonts); when off, such outlines are left to InDesign.",
        kIseUIInsideTipKey,          "When on, StrokeMaster draws Inside strokes and fills the outline itself, where InDesign's inward offset fill spills past curves; when off, InDesign draws them.",
        kIseUIOpenPathsTipKey,       "When on, open paths with a Center Miter stroke keep whole points past the miter limit, as closed shapes do; when off, InDesign draws them.",
        kIseUITransparencyTipKey,    "When on, objects with opacity, blend modes, or object-level effects are corrected too, and a translucent stroke is drawn as one piece; when off, such objects are left to InDesign.",
        kIseUIRestoreTipKey,         "Turns every switch back on, except Across separate stories, which goes back off.",
    }
};

