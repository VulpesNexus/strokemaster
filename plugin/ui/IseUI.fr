resource IseUIPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
    __FILE__, __LINE__,
    kIseUIPanelWidgetID,
    kPMRsrcID_None,
    kBindNone,
    Frame(0, 0, 270, 418),
    kTrue, kTrue,
    kFalse,
    kInterfacePaletteFill,
    kFalse,
    kIseUIPanelTitleKey,
    {
        IseUICheckBoxWidget(kIseUIEnabledWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 8, 262, 26) kTrue, kTrue, kAlignLeft, kIseUIEnabledKey),
        SeparatorWidget(kIseUIMasterSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 32, 262, 33) kTrue, kTrue),

        StaticTextWidget(kIseUITextHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 42, 262, 58) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUITextHeadKey, 0),
        IseUICheckBoxWidget(kIseUITextBehindWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 60, 262, 78) kTrue, kTrue, kAlignLeft, kIseUITextBehindKey),
        IseUICheckBoxWidget(kIseUITextStoryWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 80, 262, 98) kTrue, kTrue, kAlignLeft, kIseUITextStoryKey),
        IseUICheckBoxWidget(kIseUITextStoriesWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(48, 100, 262, 118) kTrue, kTrue, kAlignLeft, kIseUITextStoriesKey),
        IseUICheckBoxWidget(kIseUITextMiterWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 120, 262, 138) kTrue, kTrue, kAlignLeft, kIseUITextMiterKey),

        SeparatorWidget(kIseUIShapesSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindTop, Frame(8, 146, 262, 147) kTrue, kTrue),
        StaticTextWidget(kIseUIShapesHeadWidgetID, kSysStaticTextPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(8, 154, 262, 170) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUIShapesHeadKey, 0),
        IseUICheckBoxWidget(kIseUIShapesWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(16, 172, 262, 190) kTrue, kTrue, kAlignLeft, kIseUIShapesKey),
        IseUICheckBoxWidget(kIseUIWholePointsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 192, 262, 210) kTrue, kTrue, kAlignLeft, kIseUIWholePointsKey),
        IseUICheckBoxWidget(kIseUIPatternPointsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(48, 212, 262, 230) kTrue, kTrue, kAlignLeft, kIseUIPatternPointsKey),
        IseUICheckBoxWidget(kIseUIGlyphTipsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 232, 262, 250) kTrue, kTrue, kAlignLeft, kIseUIGlyphTipsKey),
        IseUICheckBoxWidget(kIseUIEffectCornersWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 252, 262, 270) kTrue, kTrue, kAlignLeft, kIseUIEffectCornersKey),
        IseUICheckBoxWidget(kIseUIWordOutlineWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 272, 262, 290) kTrue, kTrue, kAlignLeft, kIseUIWordOutlineKey),
        IseUICheckBoxWidget(kIseUIOverlapsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 292, 262, 310) kTrue, kTrue, kAlignLeft, kIseUIOverlapsKey),
        IseUICheckBoxWidget(kIseUIInsideWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 312, 262, 330) kTrue, kTrue, kAlignLeft, kIseUIInsideKey),
        IseUICheckBoxWidget(kIseUIOpenPathsWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 332, 262, 350) kTrue, kTrue, kAlignLeft, kIseUIOpenPathsKey),
        IseUICheckBoxWidget(kIseUITransparencyWidgetID, kSysCheckBoxPMRsrcId, kBindLeft | kBindRight | kBindTop, Frame(32, 352, 262, 370) kTrue, kTrue, kAlignLeft, kIseUITransparencyKey),

        SeparatorWidget(kIseUIFooterSeparatorWidgetID, kPMRsrcID_None, kBindLeft | kBindRight | kBindBottom, Frame(8, 380, 262, 381) kTrue, kTrue),
        IseUIButtonWidget(kIseUIRestoreWidgetID, kSysButtonPMRsrcId, kBindLeft | kBindBottom, Frame(8, 388, 128, 410) kTrue, kTrue, kIseUIRestoreKey),
        StaticTextWidget(kIseUINoteWidgetID, kSysStaticTextPMRsrcId, kBindRight | kBindBottom, Frame(136, 391, 266, 407) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUINoteKey, 0),
    }
    kIseUIInternalMenuNameKey
};

