    { kWildFS },
    kUIPlugIn,
    kIseUIVersion
};

resource ExtraPluginInfo(1)
{
    kIseUICompanyValue,
    kSDKDefPartnersStandardValue_enUS,
    kSDKDefMissingPluginAlertValue,
};

resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
    /** The panel: keeps its checkboxes and the switches' file in step. */
    Class
    {
        kIseUIPanelWidgetBoss,
        kPalettePanelWidgetBoss,
        {
            IID_IPANELMENUDATA, kCPanelMenuDataImpl,
            IID_IOBSERVER, kIseUIPanelObserverImpl,
        }
    },
    /** The panel menu's Restore Defaults. */
    Class
    {
        kIseUIActionComponentBoss,
        kBaseActionComponentBoss,
        {
            IID_IACTIONCOMPONENT, kIseUIActionComponentImpl,
        }
    },
}}};

