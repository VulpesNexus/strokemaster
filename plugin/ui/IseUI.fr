resource IseUIPanelWidget(kSDKDefPanelResourceID + index_enUS)
{
    __FILE__, __LINE__,
    kIseUIPanelWidgetID,
    kPMRsrcID_None,
    kBindNone,
    Frame(0, 0, 270, 372),
    kTrue, kTrue,
    kFalse,
    kInterfacePaletteFill,
    kFalse,
    kIseUIPanelTitleKey,
    {
        CheckBoxWidget(kIseUIEnabledWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(8, 8, 262, 26) kTrue, kTrue, kAlignLeft, kIseUIEnabledKey),

        StaticTextWidget(kIseUITextHeadWidgetID, kSysStaticTextPMRsrcId, kBindNone, Frame(8, 34, 262, 50) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUITextHeadKey, 0),
        CheckBoxWidget(kIseUITextBehindWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(16, 52, 262, 70) kTrue, kTrue, kAlignLeft, kIseUITextBehindKey),
        CheckBoxWidget(kIseUITextStoryWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 72, 262, 90) kTrue, kTrue, kAlignLeft, kIseUITextStoryKey),
        CheckBoxWidget(kIseUITextStoriesWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(48, 92, 262, 110) kTrue, kTrue, kAlignLeft, kIseUITextStoriesKey),
        CheckBoxWidget(kIseUITextMiterWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 112, 262, 130) kTrue, kTrue, kAlignLeft, kIseUITextMiterKey),

        StaticTextWidget(kIseUIShapesHeadWidgetID, kSysStaticTextPMRsrcId, kBindNone, Frame(8, 138, 262, 154) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUIShapesHeadKey, 0),
        CheckBoxWidget(kIseUIShapesWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(16, 156, 262, 174) kTrue, kTrue, kAlignLeft, kIseUIShapesKey),
        CheckBoxWidget(kIseUIWholePointsWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 176, 262, 194) kTrue, kTrue, kAlignLeft, kIseUIWholePointsKey),
        CheckBoxWidget(kIseUIPatternPointsWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(48, 196, 262, 214) kTrue, kTrue, kAlignLeft, kIseUIPatternPointsKey),
        CheckBoxWidget(kIseUIGlyphTipsWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 216, 262, 234) kTrue, kTrue, kAlignLeft, kIseUIGlyphTipsKey),
        CheckBoxWidget(kIseUIEffectCornersWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 236, 262, 254) kTrue, kTrue, kAlignLeft, kIseUIEffectCornersKey),
        CheckBoxWidget(kIseUIWordOutlineWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 256, 262, 274) kTrue, kTrue, kAlignLeft, kIseUIWordOutlineKey),
        CheckBoxWidget(kIseUIOverlapsWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 276, 262, 294) kTrue, kTrue, kAlignLeft, kIseUIOverlapsKey),
        CheckBoxWidget(kIseUIInsideWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 296, 150, 314) kTrue, kTrue, kAlignLeft, kIseUIInsideKey),
        CheckBoxWidget(kIseUIOpenPathsWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(150, 296, 262, 314) kTrue, kTrue, kAlignLeft, kIseUIOpenPathsKey),
        CheckBoxWidget(kIseUITransparencyWidgetID, kSysCheckBoxPMRsrcId, kBindNone, Frame(32, 316, 262, 334) kTrue, kTrue, kAlignLeft, kIseUITransparencyKey),

        ButtonWidget(kIseUIRestoreWidgetID, kSysButtonPMRsrcId, kBindNone, Frame(8, 342, 128, 364) kTrue, kTrue, kIseUIRestoreKey),
        StaticTextWidget(kIseUINoteWidgetID, kSysStaticTextPMRsrcId, kBindNone, Frame(136, 345, 266, 361) kTrue, kTrue, kAlignLeft, kEllipsizeEnd, kTrue, kIseUINoteKey, 0),
    }
    kIseUIInternalMenuNameKey
};

