#include <winres.h>
#include "winver.h"
#include "IseUIID.h"
#include "StrokeMasterAboutRes.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      kIseUICompanyValue "\0"
            VALUE "FileDescription",  "StrokeMaster panel: switches for the StrokeMaster engine\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     kIseUIPluginName "\0"
            VALUE "OriginalFilename", kIseUIPluginName ".pln\0"
            VALUE "ProductName",      kIseUICompanyValue "\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Vixen420. GPL-3.0-or-later with an Adobe InDesign SDK linking exception.\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The About window (StrokeMasterAbout.cpp), the same template tools/AboutHarness builds.
#include "StrokeMasterAbout.rc"
