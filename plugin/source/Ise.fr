//========================================================================================
//
//  Resources for the InDesign Stroke Engine plugin.
//
//  Declares the plugin and one boss: a global text adornment, registered through the API's
//  global text adornment service. InDesign then calls it for every wax run in every text
//  frame, once per draw pass the adornment asks for.
//
//========================================================================================

//===========================
//  General includes:
//===========================
#include "LocaleIndex.h"
#include "PMLocaleIds.h"
#include "StringTable.fh"
#include "objectmodeltypes.fh"
#include "ShuksanID.h"
#include "BuildNumber.h"
#include "TextID.h"
#ifdef ISE_ROUTE_X
#include "GraphicsID.h"
#include "DocumentID.h"
#endif
#include "PlugInModel_UIAttributes.h"

//===========================
//  Project includes:
//===========================
#include "IseID.h"

#ifdef __ODFRC__

/*
// Plugin version definition.
*/
resource PluginVersion (kSDKDefPluginVersionResourceID)
{
    kTargetVersion,
    kIsePluginID,
    kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
    kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
    kIseLastMajorFormatChange, kIseLastMinorFormatChange,
    { kInDesignProduct, kInCopyProduct },
    { kWildFS },
#ifdef ISE_ROUTE_X
    // A model plugin: InDesign loads it on worker threads too, so its adornments and its draw
    // event handler also run in background PDF export. A UI plugin runs on the main thread
    // only, and background export then draws natively (route W's certified build is one).
    kModelPlugIn,
#else
    kUIPlugIn,
#endif
    kIseVersion
};

/*
// Shown in the Missing Plug-in dialog if a document that used this plugin is opened without it.
// This plugin adds no document data, so it is here only for completeness.
*/
resource ExtraPluginInfo(1)
{
    kIseCompanyValue,
    kIseMissingPluginURLValue,
    kIseMissingPluginAlertValue,
};

/*
// Boss class definitions.
*/
resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
    /** Repaints text fills after the frame's text pass. The boss carries the API's global
        text adornment service implementation, which registers it with the text drawing code,
        plus this plugin's adornment implementation.
    */
    Class
    {
        kIseFillRepaintAdornmentBoss,
        kInvalidClass,
        {
            /** Registers the boss as a provider of the global text adornment service.
                (API-provided implementation.)
            */
            IID_IK2SERVICEPROVIDER, kGlobalTextAdornmentServiceImpl,
            /** The drawing behavior. See IseFillRepaintAdornment.cpp. */
            IID_IGLOBALTEXTADORNMENT, kIseFillRepaintAdornmentImpl,
        }
    },
#ifdef ISE_ROUTE_W
    /** Experimental route W, Background pass: draws Outside text strokes beneath every fill
        of their frame and mutes them for the Text pass. See IseStrokeBehindAdornment.cpp.
    */
    Class
    {
        kIseStrokeBehindAdornmentBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kGlobalTextAdornmentServiceImpl,
            IID_IGLOBALTEXTADORNMENT, kIseStrokeBehindAdornmentImpl,
        }
    },
    /** Experimental route W, Foreground pass: restores the muted stroke paint. */
    Class
    {
        kIseStrokeRestoreAdornmentBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kGlobalTextAdornmentServiceImpl,
            IID_IGLOBALTEXTADORNMENT, kIseStrokeRestoreAdornmentImpl,
        }
    },
#endif
#ifdef ISE_ROUTE_X
    /** Experimental route X: a session-wide draw event handler that brackets each traversal
        and reports the content drawn in it. See IseCrossFrame.cpp.
    */
    Class
    {
        kIseXfDrawEventBoss,
        kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kIseXfDrawEventServiceImpl,
            IID_IDRWEVTHANDLER, kIseXfDrawEventHandlerImpl,
        }
    },
    AddIn
    {
        kDocBoss, kInvalidClass,
        {
            IID_ISESCREENOBSERVER, kIseScreenObserverImpl,
            IID_ISESCREENIDLE, kIseScreenIdleImpl,
        }
    },
    Class
    {
        kIseScreenDocResponderBoss, kInvalidClass,
        {
            IID_IK2SERVICEPROVIDER, kIseScreenDocServiceImpl,
            IID_IRESPONDER, kIseScreenDocResponderImpl,
        }
    },
#endif
}}};

/*
// Implementation definition: which implementation IDs this library can manufacture.
//
// The class description table above says that implementation kIseFillRepaintAdornmentImpl
// provides IID_IGLOBALTEXTADORNMENT on the boss, but it does not say where that implementation
// comes from. Without this resource InDesign knows the boss and its interfaces and still has
// no way to create it, so the boss is never instantiated and the adornment never runs, while
// the library itself loads normally. Of the 262 plugins installed with InDesign, 260 carry one
// of these.
//
// IseFactoryList.h is read twice: the C++ compiler expands REGISTER_PMINTERFACE into the
// factory that creates the class, and the resource compiler expands it into the entry below.
*/
resource FactoryList (kSDKDefFactoryListResourceID)
{
    kImplementationIDSpace,
    {
#include "IseFactoryList.h"
    }
};

#endif // __ODFRC__
